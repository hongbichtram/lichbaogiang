rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAppAdmin() {
      return isAuthenticated() && (
        request.auth.uid == "dUppwv43zEgXLqetfoClHDWUpFD2" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // 1. User Accounts collection (users/{userId})
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAppAdmin());
      allow create: if isAuthenticated() && (
        isAppAdmin() || 
        (request.auth.uid == userId && 
         request.resource.data.role == 'teacher' && 
         request.resource.data.status == 'active')
      );
      allow update: if isAuthenticated() && (
        isAppAdmin() || 
        (request.auth.uid == userId && 
         request.resource.data.role == resource.data.role && 
         request.resource.data.status == resource.data.status)
      );
      allow delete: if isAppAdmin();
    }

    // 2. Teacher Profiles collection (teachers/{userId})
    match /teachers/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAppAdmin());
      
      match /timetableVersions/{versionId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAppAdmin());
      }

      match /academicYearConfigs/{configId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAppAdmin());
      }
    }

    // 3. PPCT Curriculums (curriculums/{userId}) - Legacy/Current
    match /curriculums/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAppAdmin());
    }

    // 3b. Shared Curriculum Library (curriculumLibrary/{curriculumId})
    match /curriculumLibrary/{curriculumId} {
      allow read: if isAuthenticated();
      allow write: if isAppAdmin();
    }

    // 3c. Teacher-Specific Curriculum Data (teacherCurriculumData/{userId})
    match /teacherCurriculumData/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAppAdmin());
    }

    // 4. Weekly Schedules (weeklySchedules/{userId})
    match /weeklySchedules/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAppAdmin());
    }

    // 5. Custom Week Dates (customWeekDates/{userId})
    match /customWeekDates/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAppAdmin());
    }

    // 6. Print Settings (printSettings/{userId})
    match /printSettings/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAppAdmin());
    }

    // 7. Debug logs / Connection test (debug/{userId})
    match /debug/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAppAdmin());
    }
  }
}

